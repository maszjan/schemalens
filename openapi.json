  "info": {
    "description": "Send a document (photo, scan, PDF, screenshot) with a preset or a JSON Schema and get validated JSON back, with a confidence and evidence for every field.\n\nEvery call except `/healthz` and the docs needs an API key: `Authorization: Bearer <key>` or `X-API-Key`. Documents are processed in memory and never stored. Errors are RFC 9457 problem documents.\n",
    "title": "SchemaLens API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/demo": {
      "get": {
        "operationId": "demo_info",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoInfo"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Limits of this demo deployment",
        "tags": [
          "extraction"
        ]
      }
    },
    "/api/v1/extract": {
      "post": {
        "description": "Send a document with a `preset`, a `schema`, or both (the schema extends the preset).\n\nThe document is processed in memory and forgotten: nothing is written to disk, logged or\nkept. The demo takes small documents (see `GET /api/v1/demo`) and a few per day per address.\n\nThe result comes as JSON (with confidence, evidence, timings and the detected language),\nCSV or XLSX (`?format=` or `Accept`). With `?stream=true` the JSON result is preceded\nby progress events (NDJSON), so a client can show what is happening while it waits.",
        "operationId": "extract_document",
        "parameters": [
          {
            "description": "Result format; wins over the Accept header. Default: json.",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Result format; wins over the Accept header. Default: json.",
              "enum": [
                "json",
                "csv",
                "xlsx"
              ],
              "title": "Format"
            }
          },
          {
            "description": "CSV only: add a `<field>__confidence` column for every scalar field.",
            "in": "query",
            "name": "include_meta",
            "required": false,
            "schema": {
              "default": false,
              "description": "CSV only: add a `<field>__confidence` column for every scalar field.",
              "title": "Include Meta",
              "type": "boolean"
            }
          },
          {
            "description": "JSON only: answer with `application/x-ndjson`, one event per line as the work goes on (`accepted`, `reading`, `read`, `extracting`, then `result` or `error`). Events carry counts and timings, never document text; `result` is the usual JSON body.",
            "in": "query",
            "name": "stream",
            "required": false,
            "schema": {
              "default": false,
              "description": "JSON only: answer with `application/x-ndjson`, one event per line as the work goes on (`accepted`, `reading`, `read`, `extracting`, then `result` or `error`). Events carry counts and timings, never document text; `result` is the usual JSON body.",
              "title": "Stream",
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExtractJsonRequest"
              }
            },
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ExtractMultipartRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExtractResponse"
                }
              },
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              },
              "text/csv": {
                "example": "seller_name,total_gross,items.name,items.price\r\nExample,312.45,Paliwo,300.0\r\n",
                "schema": {
                  "type": "string"
                }
              }
            },
            "description": "Successful Response"
          },
          "406": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unknown format or unsupported Accept"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Document too large for the demo"
          },
          "415": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unsupported document or request type"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Invalid schema, request or unreadable document"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Daily demo limit reached, or all slots busy"
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The language model failed"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "The language model provider is rate limiting"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Gateway Timeout"
          }
        },
        "summary": "Extract fields from a document",
        "tags": [
          "extraction"
        ]
      }
    },
    "/api/v1/presets": {
      "get": {
        "description": "Ready-made schemas. Use a preset by name in `preset`, optionally extended by `schema`.",
        "operationId": "list_presets",

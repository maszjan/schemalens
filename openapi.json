        "type": "object"
      },
      "ExtractJsonRequest": {
        "description": "JSON variant of an extraction request. Send `schema`, `preset`, or both.",
        "examples": [
          {
            "document_base64": "<base64>",
            "preset": "business_card"
          },
          {
            "document_base64": "<base64>",
            "schema": {
              "properties": {
                "cost_category": {
                  "enum": [
                    "fuel",
                    "equipment",
                    "services",
                    "other"
                  ],
                  "type": "string",
                  "x-schemalens-derived": true
                },
                "currency": {
                  "type": "string",
                  "x-schemalens-type": "currency"
                },
                "issue_date": {
                  "format": "date",
                  "type": "string"
                },
                "seller_name": {
                  "description": "Name of the seller",
                  "type": "string"
                },
                "total_gross": {
                  "type": "number"
                }
              },
              "required": [
                "seller_name",
                "total_gross"
              ],
              "type": "object"
            }
          },
          {
            "document_base64": "<base64>",
            "options": {
              "include_ocr_text": true,
              "model_tier": "accurate"
            },
            "preset": "business_card",
            "schema": {
              "properties": {
                "industry": {
                  "description": "Industry of the company",
                  "type": "string",
                  "x-schemalens-derived": true
                }
              },
              "type": "object"
            }
          }

              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List schema presets",
        "tags": [
          "extraction"
        ]
      }
    },
    "/api/v1/render": {
      "post": {
        "description": "The export buttons of the demo: the result the browser already has, as a file. No\nextraction runs again, and nothing is stored or logged.",
        "operationId": "render_result",
        "parameters": [
          {
            "description": "Result format; wins over the Accept header. Default: json.",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Result format; wins over the Accept header. Default: json.",
              "enum": [
                "json",
                "csv",
                "xlsx"
              ],
              "title": "Format"
            }
          },
          {
            "description": "CSV only: add a `<field>__confidence` column for every scalar field.",
            "in": "query",
            "name": "include_meta",
            "required": false,
            "schema": {
              "default": false,
              "description": "CSV only: add a `<field>__confidence` column for every scalar field.",
              "title": "Include Meta",
              "type": "boolean"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {

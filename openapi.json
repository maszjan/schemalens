            ],
            "default": null,
            "description": "Name of a preset from GET /api/v1/presets",
            "title": "Preset"
          },
          "schema": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"

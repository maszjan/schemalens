# Copy to .env (never commit it)
APP=schemalens

# --- LLM: two named profiles; ACTIVE_LLM_PROFILE picks the one in use (local | groq) ---
# The pipeline, the API and the CLI use the active one; CLI --profile and evals --compare can pick the other.
ACTIVE_LLM_PROFILE=local

# local - Ollama on this machine. Nothing leaves the computer: use it for real documents.
LOCAL_BASE_URL=http://localhost:11434/v1
# Inside the API container this overrides LOCAL_BASE_URL (docker-compose.yml)
DOCKER_LOCAL_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_MODEL_FAST=<Ollama model tag, e.g. SpeakLeash/bielik-11b-v3.0-instruct:Q4_K_M>
LOCAL_MODEL_ACCURATE=<Ollama model tag>
LOCAL_TIMEOUT_S=180
# Must fit the model context (OLLAMA_CONTEXT_LENGTH, e.g. 8192) together with the prompt and the answer
# LOCAL_DIRECT_LIMIT=6000
# The whole context window of the local model; the document gets what is left after the prompt
# and the reserved answer, so a long document never overflows it.
# LOCAL_CONTEXT_WINDOW=8192
# Cap on the answer of a local model (guards against endless generation)
# LOCAL_MAX_OUTPUT_TOKENS=2000

# groq - optional hosted profile (json_schema strict). Nothing depends on it: without a key
# everything works except an explicit --profile groq / --compare groq, which fail with a clear message.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_ACCURATE=openai/gpt-oss-120b
# Reasoning effort for gpt-oss models: low | medium | high. When Groq rejects the generated JSON
# (json_validate_failed), the client retries with a higher level.
GROQ_REASONING_EFFORT=medium
# GROQ_TIMEOUT_S=60
# Document tokens per request; a longer document is cut at a page boundary with a warning
# GROQ_DIRECT_LIMIT=24000

# openai - bring your own LLM: any OpenAI-compatible endpoint (OpenAI, Azure OpenAI, vLLM,
# LM Studio, OpenRouter...). Set ACTIVE_LLM_PROFILE=openai to use it.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL_FAST=gpt-4.1-mini
# OPENAI_MODEL_ACCURATE=
# json_schema strict mode; set false for servers that only return free-form JSON
# OPENAI_STRICT_SCHEMA=true
# OPENAI_DIRECT_LIMIT=24000

# Retries (429 by Retry-After, 5xx/timeout with backoff, failed strict generation), shared
# LLM_MAX_RETRIES=2
# LLM_RETRY_BACKOFF_S=1.0
# A longer Retry-After on 429 means an exhausted quota (e.g. daily): fail at once instead of waiting
# LLM_RETRY_AFTER_MAX_S=60

# --- API (no accounts, nothing is stored) ---
# Port on this machine for docker compose (the API listens on 8000 inside the container)
# API_PORT=8000
# API keys, comma-separated: every /v1 call needs `Authorization: Bearer <key>` (or `X-API-Key`),
# and the API does not start without one. Generate: uv run schemalens-api keys new --env-file .env
API_KEYS=
# Documents per key per day; 0 = no limit
# KEY_DAILY_DOCUMENTS=0
# Browser origins allowed to call the API (your web page), comma-separated
# ALLOWED_ORIGINS=http://localhost:3000
# Size limits per document
# MAX_UPLOAD_BYTES=4194304
# MAX_PAGES=3
# Demo keys, for a public web page (the key is visible in the browser): calls with one are limited
# per client address and in total. Generate: uv run schemalens-api keys new --demo --env-file .env
# DEMO_KEYS=
# DEMO_DAILY_DOCUMENTS=10
# DEMO_GLOBAL_DAILY_DOCUMENTS=500
# Limit counters: empty = in memory; on AWS the DynamoDB table name (counters only, with a TTL)
# LIMITS_TABLE=
# Salt for hashing client addresses (an address is never stored as is)
# IP_SALT=
# How long a request may wait for the extraction (a local 11B model needs about a minute)
# SYNC_TIMEOUT_S=60
# Extractions at once (OCR runs on the CPU) and the Retry-After of a 429
# MAX_CONCURRENT_JOBS=2
# BUSY_RETRY_AFTER_S=5

# --- OCR ---
# EasyOCR models. Locally: .models/easyocr (gitignored); in Docker the image sets it.
# OCR_MODEL_DIR=.models/easyocr
# Locally only, on the first run. Never in a container.
# OCR_ALLOW_DOWNLOAD=1
# OCR_LANGS=["pl","en"]
# Quality gate before the LLM: fewer lines or a lower mean OCR confidence = 422 document-unreadable
# OCR_MIN_LINES=2
# OCR_MIN_MEAN_CONF=0.5
# MAX_IMAGE_SIDE=2000

# --- Confidence per field (docs/how-it-works.md) ---
# CONF_OCR_WEIGHT=0.7
# CONF_NO_EVIDENCE_FACTOR=0.5
# CONF_NORMALIZED_FACTOR=0.9
# CONF_RETRY_FACTOR=0.85
# CONF_CHECKSUM_FACTOR=0.5
# CONF_DERIVED_CAP=0.7
# CONF_GROUNDING_FACTOR=0.3
# CONF_SUSPICIOUS_FACTOR=0.6
# CONF_EVIDENCE_MAX_LINES=3
# CONF_EVIDENCE_MAX_SHARE=0.5

# --- Retrieval for long documents ---
# Embedding model read from disk only (in the image: /models/embed; locally save it once to .models/embed)
# EMBED_MODEL_DIR=.models/embed
# RAG_ENABLED=true

# A worked example per preset from templates/ (off by default)
# FEWSHOT_ENABLED=false
# TEMPLATES_DIR=templates

# --- Presets ---
# PRESETS_DIR=presets
